msgstr "L'URL git de base qui sera utilisée pour afficher les commandes de clonage."

#. type: item
#: guix-git/doc/guix.texi:42552
#, no-wrap
msgid "@code{index-title} (default: @code{\"Index\"})"
msgstr "@code{index-title} (par défaut : @code{\"Index\"})"

