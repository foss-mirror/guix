#: guix-git/doc/guix.texi:42541
#, no-wrap
msgid "@code{database} (default: @code{\"/var/lib/gitile/gitile-db.sql\"})"
msgstr "@code{database} (par défaut : @code{\"/var/lib/gitile/gitile-db.sql\"})"

