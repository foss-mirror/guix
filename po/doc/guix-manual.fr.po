#: guix-git/doc/contributing.texi:2142
#, no-wrap
msgid "Sending a Patch Series"
msgstr "Envoyer une série de correctifs"

#. type: cindex
#: guix-git/doc/contributing.texi:2119
#, no-wrap
msgid "git configuration"
msgstr "configuration git"

