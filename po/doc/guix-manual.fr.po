msgstr "auto-start? (par défaut : @code{#t})"

#. type: table
#: guix-git/doc/guix.texi:50143
msgid "Whether or not to start Shepherd on first login."
msgstr "Indique s'il faut lancer le Shepherd à la première connexion."

