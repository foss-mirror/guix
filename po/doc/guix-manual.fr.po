"                    #:fullscreen? #t\n"
"                    #:alang '(\"jpn\" \"eng\"))))\n"
msgstr ""
"(service tailon-service-type\n"
"         (tailon-configuration\n"
"           (config-file\n"
"             (tailon-configuration-file\n"
"               (allowed-commands '(\"tail\" \"grep\" \"awk\" \"sed\"))))))\n"

