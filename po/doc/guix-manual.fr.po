msgstr "mbox:/var/mail/%d/%1n/%n:INDEX=/var/indexes/%d/%1n/%"

#. type: deftypevr
#: guix-git/doc/guix.texi:29006 guix-git/doc/guix.texi:29018
#: guix-git/doc/guix.texi:29046 guix-git/doc/guix.texi:29817
