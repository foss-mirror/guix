"             (server-name \"git.my-host.org\")\n"
"             (ssl-certificate\n"
"              \"/etc/certs/git.my-host.org/fullchain.pem\")\n"
"             (ssl-certificate-key\n"
"              \"/etc/certs/git.my-host.org/privkey.pem\")\n"
