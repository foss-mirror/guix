"(service log-cleanup-service-type\n"
"         (log-cleanup-configuration\n"
"          (directory \"/var/log/guix/drvs\")))\n"

#. type: Plain text
#: guix-git/doc/guix.texi:21570
#, fuzzy
msgid "That ensures build logs do not accumulate endlessly."
msgstr "这确保构建日志不会无休止地累积。"

