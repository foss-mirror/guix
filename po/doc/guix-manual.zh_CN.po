msgstr "参见 @xref{Invoking guix describe}，以获取仅显示当前版本信息的方法。"

#. type: table
#: guix-git/doc/guix.texi:4764
#, fuzzy
msgid "Use @var{profile} instead of @file{~/.config/guix/current}."
msgstr "使用 @var{profile} 代替 @file{~/.config/guix/current}。"

#. type: item
#: guix-git/doc/guix.texi:4765 guix-git/doc/guix.texi:13258
#: guix-git/doc/guix.texi:15626
