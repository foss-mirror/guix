"\n"
msgstr ""
"(define garbage-collector-job\n"
"  ;; 每天午夜过5分钟收集垃圾。\n"
"  ;; 作业的操作是一个shell命令。\n"
"  #~(job \"5 0 * * *\"            ;Vixie cron语法\n"
