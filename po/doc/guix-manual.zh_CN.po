#. type: deffn
#: guix-git/doc/guix.texi:12739
#, fuzzy
msgid "The same effect could be achieved with:"
msgstr "同样的效果可以通过以下方式实现："

#. type: lisp
#: guix-git/doc/guix.texi:12744
