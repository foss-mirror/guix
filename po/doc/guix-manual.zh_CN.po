#, fuzzy, no-wrap
msgid ""
"(use-service-modules upnp @dots{})\n"
"\n"
msgstr ""
"(use-modules (gnu packages base))\n"
"\n"

#. type: lisp
#: guix-git/doc/guix.texi:45364
#, fuzzy, no-wrap
msgid ""
"(operating-system\n"
"  @dots{}\n"
