#. type: lisp
#: guix-git/doc/guix.texi:53233
#, fuzzy, no-wrap
msgid ""
"(use-modules (gnu)\n"
"             (gnu image)\n"
"             (gnu tests)\n"
"             (gnu system image)\n"
