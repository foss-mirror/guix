#. type: deftypevr
#: guix-git/doc/guix.texi:29439
#, fuzzy, no-wrap
msgid "{@code{dovecot-configuration} parameter} string ssl-cert-username-field"
msgstr "{@code{dovecot-configuration} 参数} 字符串 ssl-cert-username-field"

