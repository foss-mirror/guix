#: guix-git/doc/guix.texi:29348
#, fuzzy, no-wrap
msgid "sis posix"
msgstr "sis posix"

#. type: table
#: guix-git/doc/guix.texi:29350
#, fuzzy
msgid "SiS with immediate byte-by-byte comparison during saving"
msgstr "在保存时进行即时字节逐字节比较的 SiS"

#. type: item
#: guix-git/doc/guix.texi:29350
#, fuzzy, no-wrap
msgid "sis-queue posix"
msgstr "sis-queue posix"

#. type: table
