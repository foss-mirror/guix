"            (volume (@@ (user \"bob\")\n"
"                       (fstype \"auto\")\n"
"                       (path \"/dev/sdb3\")\n"
"                       (mountpoint \"/home/bob/data\")\n"
"                       (options \"defaults,autodefrag,compress\")))\n"
"            (mntoptions (@@ (allow ,(string-join\n"
"                                    '(\"nosuid\" \"nodev\" \"loop\"\n"
"                                      \"encryption\" \"fsck\" \"nonempty\"\n"
"                                      \"allow_root\" \"allow_other\")\n"
"                                    \",\"))))\n"
"            (mntoptions (@@ (require \"nosuid,nodev\")))\n"
"            (logout (@@ (wait \"0\")\n"
"                       (hup \"0\")\n"
"                       (term \"no\")\n"
"                       (kill \"no\")))\n"
"            (mkmountpoint (@@ (enable \"1\")\n"
"                             (remove \"true\")))))\n"
"\n"
msgstr ""
"(定义 pam-mount-rules\n"
"`((调试 (@@ (启用 \"0\")))\n"
"            (卷 (@@ (用户 \"alice\")\n"
"                       (文件系统类型 \"crypt\")\n"
"                       (路径 \"/dev/sda2\")\n"
"                       (挂载点 \"/home/alice\")))\n"
"            (卷 (@@ (用户 \"bob\")\n"
"                       (文件系统类型 \"auto\")\n"
"                       (路径 \"/dev/sdb3\")\n"
"                       (挂载点 \"/home/bob/data\")\n"
"                       (选项 \"defaults,autodefrag,compress\")))\n"
"            (mntoptions (@@ (允许 ,(string-join\n"
"                                    '(\"nosuid\" \"nodev\" \"loop\"\n"
"                                      \"encryption\" \"fsck\" \"nonempty\"\n"
"                                      \"allow_root\" \"allow_other\")\n"
"                                    \",\"))))\n"
"            (mntoptions (@@ (要求 \"nosuid,nodev\")))\n"
"            (注销 (@@ (等待 \"0\")\n"
"                       (hup \"0\")\n"
"                       (term \"no\")\n"
"                       (kill \"no\")))\n"
"            (创建挂载点 (@@ (启用 \"1\")\n"
"                             (移除 \"true\")))))\n"
"\n"

