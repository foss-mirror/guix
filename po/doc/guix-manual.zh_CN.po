#. type: deffn
#: guix-git/doc/guix.texi:13109
#, fuzzy, no-wrap
msgid "{REPL command} verbosity @var{level}"
msgstr "{REPL command} verbosity @var{level}"

#. type: deffn
#: guix-git/doc/guix.texi:13111
#, fuzzy
msgid "Change build verbosity to @var{level}."
