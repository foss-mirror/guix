"\n"
msgstr ""
"(使用模块 (gnu)\n"
"             (gnu image)\n"
"             (gnu tests)\n"
"             (gnu system image)\n"
"             (guix gexp)\n"
"             (ice-9 match))\n"
"\n"

#. type: lisp
#: guix-git/doc/guix.texi:53247
#, fuzzy, no-wrap
msgid ""
"(define data\n"
"  (partition\n"
"   (size (* 50 MiB))\n"
"   (label \"DATA\")\n"
"   (file-system \"ext4\")\n"
"   (initializer #~(lambda* (root . rest)\n"
"                    (mkdir root)\n"
"                    (call-with-output-file\n"
"                        (string-append root \"/data\")\n"
"                      (lambda (port)\n"
"                        (format port \"my-data\")))))))\n"
"\n"
msgstr ""
"(定义数据\n"
"  (分区\n"
"   (大小 (* 50 MiB))\n"
"   (标签 \"DATA\")\n"
"   (文件系统 \"ext4\")\n"
"   (初始化器 #~(lambda* (root . rest)\n"
"                    (mkdir root)\n"
"                    (call-with-output-file\n"
"                        (string-append root \"/data\")\n"
"                      (lambda (port)\n"
"                        (format port \"my-data\")))))))\n"
"\n"

#. type: lisp
#: guix-git/doc/guix.texi:53255
#, fuzzy, no-wrap
msgid ""
"(image\n"
" (inherit efi-disk-image)\n"
" (operating-system %simple-os)\n"
" (partitions\n"
"  (match (image-partitions efi-disk-image)\n"
"    ((esp root)\n"
"     (list esp data root)))))\n"
msgstr ""
"(图像\n"
" (继承 efi-disk-image)\n"
" (操作系统 %simple-os)\n"
" (分区\n"
"  (匹配 (image-partitions efi-disk-image)\n"
"    ((esp root)\n"
"     (列表 esp data root)))))\n"

#. type: Plain text
#: guix-git/doc/guix.texi:53259
msgid "This will give the exact same @code{image} instantiation but the @code{image} declaration is simpler."
