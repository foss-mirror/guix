"                                        \"audio\" \"video\")))\n"
"               %base-user-accounts))\n"
"  (services\n"
"    (append (list (service iptables-service-type)\n"
"                  (service rootless-podman-service-type\n"
"                           (rootless-podman-configuration\n"
"                             (subgids\n"
"                               (list (subid-range (name \"alice\"))))\n"
"                             (subuids\n"
"                               (list (subid-range (name \"alice\")))))))\n"
"            %base-services)))\n"

